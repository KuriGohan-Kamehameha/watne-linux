# Candidate identity
CANDIDATE_ID=navio2-v1-alpha1

# Target stack
DEBIAN_RELEASE=trixie
TARGET_ARCH=arm64

# Source refs
RPI_LINUX_REPO=https://github.com/raspberrypi/linux.git
RPI_LINUX_BRANCH=rpi-6.12.y
RPI_FIRMWARE_REPO=https://github.com/raspberrypi/firmware.git
RPI_FIRMWARE_REF=master
ARDUPILOT_REPO=https://github.com/ArduPilot/ardupilot.git
ARDUPILOT_TAG=Copter-4.6.3

# Kernel build
KERNEL_DEFCONFIG=bcm2711_defconfig
KERNEL_LOCALVERSION=-navio2rt-v1
KERNEL_IMAGE_NAME=Image
KERNEL_JOBS=8

# Toolchain
CROSS_COMPILE=aarch64-linux-gnu-
MAKE_BIN=make

# RealSense
REALSENSE_REPO=https://github.com/IntelRealSense/librealsense.git
REALSENSE_TAG=v2.55.1

# ROS 2
ROS2_DISTRO=jazzy

# ArduPilot build
ARDUPILOT_VEHICLE=copter
ARDUPILOT_BOARD=navio2

# Image assembly
BOOT_PARTITION_SIZE_MB=256

# Workspace layout
WORK_ROOT=build/work
SRC_ROOT=build/work/src
OUT_ROOT=build/work/out
LOG_ROOT=build/work/logs

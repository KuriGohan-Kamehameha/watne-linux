# Global Navio2 gate settings
# Set to 1 to simulate actions and skip hard failures on missing Navio2 paths.
DRY_RUN=0

# Common paths
RCIO_ROOT=/sys/kernel/rcio
RCIO_ADC_DIR=/sys/kernel/rcio/adc
PWMCHIP_PATH=/sys/class/pwm/pwmchip0
SPI_NODE=/dev/spidev0.0
GPS_STATUS_PATH=/run/navio2/gps_status

# Module gate
REQUIRED_MODULES="rcio_adc rcio_pwm"
MODULE_EXPECTED_PATHS="${RCIO_ADC_DIR} ${PWMCHIP_PATH} ${SPI_NODE}"

# Permissions gate
PERMISSIONS_GROUP=dialout
PERMISSIONS_MODE=0660
PERMISSIONS_PATHS="${RCIO_ADC_DIR}/ch0 ${RCIO_ADC_DIR}/ch1 ${RCIO_ADC_DIR}/ch2 ${RCIO_ADC_DIR}/ch3 ${RCIO_ADC_DIR}/ch4 ${RCIO_ADC_DIR}/ch5 ${SPI_NODE}"

# Time sync gate
TIME_SYNC_TIMEOUT_SEC=120
TIME_SYNC_INTERVAL_SEC=2

# GPS lock gate
GPS_LOCK_VALUE=LOCKED
GPS_TIMEOUT_SEC=180
GPS_INTERVAL_SEC=2

# Preflight gate
ADC_CHANNELS="0 1 2 3 4 5"
ADC_PATH_PREFIX="${RCIO_ADC_DIR}/ch"
PREFLIGHT_LOG_FILE=/var/log/navio2-preflight.log
PREFLIGHT_REQUIRE_SPI=0

# Runner behavior
RUN_GATES_CONTINUE_ON_FAIL=1
